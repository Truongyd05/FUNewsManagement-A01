@model BusinessObjects.SystemAccount
@{
    ViewData["Title"] = "My profile";
}

<div class="fnm-page-head">
    <div>
        <span class="fnm-kicker">Account</span>
        <h1 class="fnm-page-title">My profile</h1>
    </div>
    <button class="btn btn-primary" data-modal-url="@Url.Action("EditProfile")">Edit profile</button>
</div>

<div class="fnm-profile">
    <div class="fnm-profile-head">
        <span class="fnm-avatar">@(string.IsNullOrEmpty(Model.AccountName) ? "?" : Model.AccountName.Substring(0, 1).ToUpperInvariant())</span>
        <div>
            <div class="fnm-profile-name">@Model.AccountName</div>
            <span class="fnm-badge is-active">@BusinessObjects.AccountRole.GetName(Model.AccountRole)</span>
        </div>
    </div>

    <dl class="fnm-dl">
        <dt>ID</dt><dd>@Model.AccountId</dd>
        <dt>Name</dt><dd>@Model.AccountName</dd>
        <dt>Email</dt><dd>@Model.AccountEmail</dd>
        <dt>Role</dt><dd>@BusinessObjects.AccountRole.GetName(Model.AccountRole)</dd>
    </dl>
</div>
