@model BusinessObjects.SystemAccount
@{
    ViewData["Title"] = "My profile";
}

<div class="fnm-page-head">
    <h1 class="fnm-page-title">My profile</h1>
</div>

<div class="card" style="max-width: 560px">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="fnm-avatar" style="width:56px;height:56px;font-size:1.4rem">@(string.IsNullOrEmpty(Model.AccountName) ? "?" : Model.AccountName.Substring(0, 1).ToUpperInvariant())</span>
            <div>
                <div class="fs-5 fw-semibold">@Model.AccountName</div>
                <span class="badge bg-primary">@BusinessObjects.AccountRole.GetName(Model.AccountRole)</span>
            </div>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">ID</dt><dd class="col-sm-8">@Model.AccountId</dd>
            <dt class="col-sm-4 text-muted">Name</dt><dd class="col-sm-8">@Model.AccountName</dd>
            <dt class="col-sm-4 text-muted">Email</dt><dd class="col-sm-8">@Model.AccountEmail</dd>
            <dt class="col-sm-4 text-muted">Role</dt><dd class="col-sm-8">@BusinessObjects.AccountRole.GetName(Model.AccountRole)</dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex justify-content-end">
        <button class="btn btn-primary" data-modal-url="@Url.Action("EditProfile")">Edit profile</button>
    </div>
</div>
