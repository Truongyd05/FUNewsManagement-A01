@model BusinessObjects.SystemAccount
@{
    ViewData["Title"] = "My profile";
}

<h2>My profile</h2>
<div class="card" style="max-width: 560px">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@Model.AccountId</dd>
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.AccountName</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.AccountEmail</dd>
            <dt class="col-sm-4">Role</dt><dd class="col-sm-8">@BusinessObjects.AccountRole.GetName(Model.AccountRole)</dd>
        </dl>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" data-modal-url="@Url.Action("EditProfile")">Edit profile</button>
    </div>
</div>
