@model BusinessObjects.NewsArticle
@{
    ViewData["Title"] = Model.NewsTitle;
}

<div class="fnm-article-wrap">
    <a asp-action="Index" class="fnm-backlink">&lsaquo; Back to news</a>

    <article class="fnm-article">
        <span class="fnm-kicker">@(Model.Category?.CategoryName ?? "News")</span>
        <h1 class="fnm-article-title">@Model.NewsTitle</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Headline))
        {
            <p class="fnm-article-standfirst">@Model.Headline</p>
        }

        <div class="fnm-article-byline">
            <span>By <strong>@(Model.CreatedBy?.AccountName ?? "FU News")</strong></span>
            <span class="fnm-sep">·</span>
            <span>@Model.CreatedDate?.ToString("dd MMMM yyyy, HH:mm")</span>
            @if (!string.IsNullOrWhiteSpace(Model.NewsSource))
            {
                <span class="fnm-sep">·</span>
                <span>Source: @Model.NewsSource</span>
            }
            <span class="fnm-sep">·</span>
            <span class="fnm-status @(Model.NewsStatus == true ? "is-active" : "")">@(Model.NewsStatus == true ? "Active" : "Inactive")</span>
        </div>

        <div class="fnm-article-body">@Model.NewsContent</div>

        @if (Model.Tags.Any())
        {
            <div class="fnm-article-tags">
                @foreach (var t in Model.Tags)
                {
                    <a class="fnm-tag" asp-action="Index" asp-route-keyword="@t.TagName">@t.TagName</a>
                }
            </div>
        }
    </article>
</div>
